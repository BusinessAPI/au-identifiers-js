{
  "name": "au-identifiers",
  "version": "1.0.1",
  "description": "Validate and format Australian identifiers: ABN, ACN, ARBN, TFN, Director ID and VIN.",
  "keywords": [
    "abn",
    "acn",
    "arbn",
    "tfn",
    "vin",
    "director-id",
    "australia",
    "validation",
    "validator",
    "checksum",
    "ato",
    "asic"
  ],
  "homepage": "https://businessapi.com.au",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BusinessAPI/au-identifiers-js.git"
  },
  "bugs": "https://github.com/BusinessAPI/au-identifiers-js/issues",
  "license": "MIT",
  "author": "Business API <dev@businessapi.com.au>",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "npm run build && node --test test/vectors.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
